<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
<%- headMeta %>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;1,600&family=DM+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles.css" />
  <script defer src="/i18n.js"></script>
  <script defer src="/external-links.js"></script>
</head>
<body id="<%= typeof bodyId !== 'undefined' ? bodyId : 'top' %>">
  <header class="nav">
    <div class="nav-inner">
      <a class="brand" href="/"><img class="brand-logo" src="/Logo_white_solo.png" width="359" height="82" alt="openWCS" /></a>
      <button class="nav-toggle" id="nav-toggle" type="button" aria-label="Toggle menu" aria-expanded="false"><span class="bars" aria-hidden="true"></span></button>
      <nav class="nav-links" aria-label="Primary">
        <div class="nav-group" data-nav-group>
          <button class="nav-group-btn" type="button" aria-expanded="false" aria-haspopup="true">
            <span data-i18n="navGrpFunctions">Functions</span>
            <svg class="chev" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div class="nav-menu">
            <a href="/functions" data-i18n="navFnAll">All functions</a>
            <a href="/process-designer" data-i18n="navFnProcess">Process designer</a>
            <a href="/inventory" data-i18n="navFnInventory">Inventory</a>
            <a href="/allocation" data-i18n="navFnAllocation">Allocation</a>
            <a href="/slotting" data-i18n="navFnSlotting">Slotting</a>
            <a href="/replenishment" data-i18n="navFnReplenishment">Replenishment</a>
            <a href="/picking" data-i18n="navFnPicking">Picking</a>
            <a href="/cycle-counting" data-i18n="navFnCycle">Cycle counting</a>
            <a href="/kpi-dashboards" data-i18n="navFnKpi">KPI dashboards</a>
            <a href="/host-api" data-i18n="navFnHostApi">Host API</a>
            <a href="/security" data-i18n="navFnSecurity">Security</a>
            <a href="/living-docs" data-i18n="navFnLivingDocs">Living docs</a>
          </div>
        </div>
        <div class="nav-group" data-nav-group>
          <button class="nav-group-btn" type="button" aria-expanded="false" aria-haspopup="true">
            <span data-i18n="navGrpAutomation">Automation</span>
            <svg class="chev" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div class="nav-menu">
            <a href="/automation" data-i18n="navAutoAll">Automation overview</a>
            <a href="/conveyors" data-i18n="navAutoConveyors">Conveyors</a>
            <a href="/asrs" data-i18n="navAutoAsrs">ASRS</a>
            <a href="/gtp" data-i18n="navAutoGtp">Goods-to-person</a>
            <a href="/hardware-visualisation" data-i18n="navAutoHw">Hardware visualisation</a>
          </div>
        </div>
        <a href="/architecture" data-i18n="navArch">Architecture</a>
        <a href="/roadmap" data-i18n="navGrpRoadmap">Roadmap</a>
        <div class="nav-group" data-nav-group>
          <button class="nav-group-btn" type="button" aria-expanded="false" aria-haspopup="true">
            <span data-i18n="navGrpWhy">Why openWCS</span>
            <svg class="chev" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div class="nav-menu">
            <a href="/#why" data-i18n="navWhy">Why open</a>
            <a href="/#compare" data-i18n="navCmp">vs. locked-in WCS</a>
            <a href="/#capabilities" data-i18n="navCap">Capabilities</a>
          </div>
        </div>
      </nav>
      <div class="nav-right">
        <div class="lang" id="lang">
          <button class="lang-toggle" id="lang-toggle" type="button" aria-haspopup="listbox" aria-expanded="false" aria-label="Select language">
            <svg class="globe" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.6 2.7 2.6 15.3 0 18M12 3c-2.6 2.7-2.6 15.3 0 18"/></svg>
            <span class="lang-code" id="lang-code">EN</span>
            <svg class="chev" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <ul class="lang-menu" id="lang-menu" role="listbox" aria-label="Language">
            <li role="option" data-lang="en"><span>English</span></li>
            <li role="option" data-lang="de"><span>Deutsch</span></li>
            <li role="option" data-lang="fr"><span>Français</span></li>
            <li role="option" data-lang="es"><span>Español</span></li>
            <li role="option" data-lang="zh"><span>中文</span></li>
            <li role="option" data-lang="pt"><span>Português</span></li>
          </ul>
        </div>
        <a class="btn btn-primary btn-nav" href="/live-demo" data-i18n="btnDemoNav">Live demo</a>
        <div class="nav-actions">
          <a class="nav-icon-btn" href="https://app.openwcs.ai" target="_blank" rel="noopener" data-i18n-title="btnDemoFullBox" aria-label="Full demo box" title="Full demo box">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6"/><path d="M20 4l-9 9"/><path d="M18 13v5a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h5"/></svg>
          </a>
          <a class="nav-icon-btn" href="https://github.com/brettljausn-ai/openwcs" target="_blank" rel="noopener" data-i18n-title="btnGitHubNav" aria-label="GitHub" title="GitHub">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.575.106.785-.25.785-.556 0-.274-.01-1.002-.016-1.966-3.196.695-3.87-1.54-3.87-1.54-.523-1.328-1.276-1.682-1.276-1.682-1.043-.713.08-.699.08-.699 1.153.081 1.76 1.184 1.76 1.184 1.026 1.757 2.692 1.25 3.348.956.104-.743.401-1.25.73-1.538-2.552-.29-5.235-1.276-5.235-5.68 0-1.255.448-2.28 1.183-3.084-.119-.29-.513-1.459.112-3.041 0 0 .965-.309 3.163 1.178a11 11 0 0 1 2.88-.387c.977.004 1.96.132 2.88.387 2.196-1.487 3.16-1.178 3.16-1.178.626 1.582.232 2.751.114 3.041.737.804 1.182 1.829 1.182 3.084 0 4.415-2.687 5.386-5.247 5.671.413.355.78 1.056.78 2.129 0 1.537-.014 2.776-.014 3.154 0 .309.208.668.79.555A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5"/></svg>
          </a>
          <a class="nav-icon-btn" href="https://www.patreon.com/c/karlfriesenbichler" target="_blank" rel="noopener" data-i18n-title="btnPatreon" aria-label="Patreon" title="Patreon">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M14.82 2.41c-4.4 0-7.98 3.58-7.98 7.98 0 4.38 3.58 7.95 7.98 7.95 4.38 0 7.95-3.57 7.95-7.95 0-4.4-3.57-7.98-7.95-7.98M1.5 21.6h3.9V2.41H1.5z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </header>

<%- body %>

  <footer>
    <div class="wrap">
      <span data-i18n="footerTag">openWCS — open-source Warehouse Control System · AGPL-3.0.</span>
      <span><a href="/license" data-i18n="footerLicense">License</a> · <a href="https://github.com/brettljausn-ai/openwcs" target="_blank" rel="noopener">GitHub</a> · <a href="https://github.com/brettljausn-ai/openwcs/wiki" target="_blank" rel="noopener">Docs</a> · <a href="https://www.patreon.com/c/karlfriesenbichler" target="_blank" rel="noopener">Sponsor</a> · <a href="#" data-contact-open data-i18n="footerContact">Contact</a></span>
    </div>
  </footer>

  <div class="contact-overlay" id="contact-overlay" data-open="false" role="dialog" aria-modal="true" aria-labelledby="contact-title" hidden>
    <div class="contact-dialog">
      <button class="contact-close" type="button" data-contact-close aria-label="Close">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
      <h2 id="contact-title" data-i18n="contactTitle">Contact us</h2>
      <p class="contact-intro" data-i18n="contactIntro">Questions about openWCS, the license, or a deployment? Send us a message and we'll reply by email.</p>
      <form id="contact-form" novalidate>
        <label class="contact-label" for="contact-email" data-i18n="contactEmailLabel">Your email</label>
        <input class="contact-input" id="contact-email" type="email" name="email" required autocomplete="email" />
        <label class="contact-label" for="contact-name" data-i18n="contactNameLabel">Your name (optional)</label>
        <input class="contact-input" id="contact-name" type="text" name="name" autocomplete="name" />
        <label class="contact-label" for="contact-message" data-i18n="contactMessageLabel">Message</label>
        <textarea class="contact-input contact-textarea" id="contact-message" name="message" rows="5" required></textarea>
        <div class="contact-hp" aria-hidden="true">
          <input type="text" name="company" class="contact-hp-input" tabindex="-1" autocomplete="off" aria-hidden="true" />
        </div>
        <button type="submit" class="btn btn-primary contact-submit" data-i18n="contactSend">Send message</button>
        <p class="contact-status" id="contact-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
<%- typeof scripts !== 'undefined' ? scripts : '' %>
</body>
</html>
